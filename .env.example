# Credenciales del proyecto Supabase "cpp-quest" (org "Zottard's Org").
# La anon/publishable key es pública por diseño (protegida por RLS en la base),
# pero igual no se commitea el .env real para no acoplar el repo a un proyecto
# específico. Copiá este archivo a .env y completá los valores.
#
# Se consiguen en el dashboard de Supabase > Project Settings > API,
# o vía el MCP de Supabase: get_project_url / get_publishable_keys.
NUXT_PUBLIC_SUPABASE_URL=https://rquyfymebnhaftpljpsn.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wLYbhywQsJSNR0Czjx7s1g_mrfS-Pgg

# Key de DeepSeek (platform.deepseek.com), SECRETA de verdad (a diferencia de
# la anon key de arriba) — la usa solo server/api/generate-chapter.post.ts
# para convertir un PDF de ejercicios en un capítulo jugable. Sin esto, el
# resto de la app funciona igual; solo el botón "Generar con IA" del panel
# docente queda deshabilitado/da error.
DEEPSEEK_API_KEY=sk-tu-api-key-de-deepseek

# IMPORTANTE (deploy): las env vars no viajan con el repo — hay que cargar
# estas mismas variables a mano en Vercel (Project Settings > Environment
# Variables) del proyecto "aula-quest-progra1". Como ahora el deploy es vía
# git push a main (Vercel conectado al repo de GitHub), el código sí se
# actualiza solo, pero las env vars siguen siendo un paso manual aparte.
